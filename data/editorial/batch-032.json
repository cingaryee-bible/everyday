        "new": [{ "citationIndex": 0, "verses": [{ "chapter": 9, "verse": 44 }, { "chapter": 9, "verse": 45 }, { "chapter": 9, "verse": 46 }, { "chapter": 9, "verse": 47 }, { "chapter": 9, "verse": 48 }] }]
