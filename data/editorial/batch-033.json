        "psalm": [{ "citationIndex": 0, "verses": [{ "chapter": 129, "verse": 1 }, { "chapter": 129, "verse": 2 }, { "chapter": 129, "verse": 3 }, { "chapter": 129, "verse": 4 }] }],
