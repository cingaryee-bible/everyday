        "psalm": [{ "citationIndex": 0, "verses": [{ "chapter": 75, "verse": 1 }, { "chapter": 75, "verse": 4 }, { "chapter": 75, "verse": 6 }, { "chapter": 75, "verse": 7 }] }],
