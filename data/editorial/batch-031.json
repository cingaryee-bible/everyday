        "old": [{ "citationIndex": 0, "verses": [{ "chapter": 3, "verse": 15 }, { "chapter": 3, "verse": 17 }, { "chapter": 3, "verse": 18 }, { "chapter": 3, "verse": 21 }, { "chapter": 3, "verse": 22 }] }],
        "new": [{ "citationIndex": 0, "verses": [{ "chapter": 14, "verse": 16 }, { "chapter": 14, "verse": 17 }, { "chapter": 14, "verse": 21 }, { "chapter": 14, "verse": 22 }, { "chapter": 14, "verse": 23 }] }]
      }
