{
  "batch": "016",
  "entries": {
    "psalm 45:1-2, 6-9|hosea 3:1-5|john 18:28-32": {
      "dates": ["2027-08-28"],
      "reviewed": true,
      "themeFile": "26",
      "deck": "何西阿以婚姻演出上帝仍愛背約百姓的記號，但『買她歸我』和限制她的話也反映古代父權經濟，不能變成今日控制伴侶的許可。耶穌受審時，控告者顧着禮儀潔淨，卻借帝國權力完成殺人目的。宗教語言是否忠於愛，要看它保護人的尊嚴，還是替支配與傷害披上聖潔外衣。",
      "reflection": "我有沒有把愛、婚姻或順服說成擁有另一個人的權利？我所守的宗教規矩若與人的自由和生命衝突，真正需要被潔淨的是甚麼？",
      "quotes": {
        "psalm": [{ "citationIndex": 0, "verses": [{ "chapter": 45, "verse": 1 }, { "chapter": 45, "verse": 2 }, { "chapter": 45, "verse": 6 }, { "chapter": 45, "verse": 7 }] }],
        "old": [{ "citationIndex": 0, "verses": [{ "chapter": 3, "verse": 1 }, { "chapter": 3, "verse": 2 }, { "chapter": 3, "verse": 3 }, { "chapter": 3, "verse": 5 }] }],
        "new": [{ "citationIndex": 0, "verses": [{ "chapter": 18, "verse": 28 }, { "chapter": 18, "verse": 29 }, { "chapter": 18, "verse": 31 }, { "chapter": 18, "verse": 32 }] }]
